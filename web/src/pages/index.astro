---
import Command from "../components/Command.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TerminalPreview from "../components/TerminalPreview.astro";
import Layout from "../layouts/Layout.astro";
import packageJson from "../../../package.json";

const commands = [
  { command: "livefeed yt auth", description: "Authorize read-only YouTube access" },
  { command: "livefeed yt", description: "Follow the current YouTube live chat" },
  { command: "livefeed twitch auth", description: "Authorize Twitch chat access" },
  { command: "livefeed twitch", description: "Follow the current Twitch live chat" },
] as const;

const behavior = [
  [
    "Stream discovery",
    "Finds the broadcast that is live now. Public, unlisted, and private YouTube streams work.",
  ],
  [
    "Waiting offline",
    "Can start before the stream. It checks again and connects without a restart.",
  ],
  ["Chat history", "Loads available YouTube chat history before following new messages."],
  ["Reconnection", "Reports network loss, reconnects, and preserves messages already received."],
  [
    "Responsive layout",
    "Reflows with the terminal and keeps the newest message anchored at the bottom.",
  ],
] as const;
---

<Layout
	title="livefeed — live chat in your terminal"
	description="Read YouTube and Twitch live chat from a terminal-native feed."
>
	<SiteHeader />

	<main id="main-content">
    <section class="masthead" id="product" aria-labelledby="hero-title">
      <div class="hero-intro">
        <p class="coordinate"><span aria-hidden="true"></span>YouTube + Twitch</p>
        <h1 id="hero-title">
          <span>LIVE</span>
          <span>CHAT</span>
        </h1>
        <p class="hero-copy">
          Live chat in the terminal. Livefeed finds the stream, waits when you are offline, and
          reconnects without losing the conversation.
        </p>
        <div class="hero-install">
          <p>Install with Bun · v{packageJson.version}</p>
          <Command command="bun add --global livefeed" label="Copy install command" large />
        </div>
      </div>

      <div class="hero-preview">
        <TerminalPreview />
      </div>
    </section>

		<div class="manual" id="manual">
			<section class="manual-section" aria-labelledby="name-title">
				<div class="section-rail">
					<h2 id="name-title">About</h2>
				</div>
				<div class="manual-body name-body">
					<p class="definition">
						<strong>livefeed</strong> — a read-only live chat client for streamers who work
						from the terminal.
					</p>
					<p>
						No stream key. No provider secret in the package. No browser window left open
						beside the stream.
					</p>
				</div>
			</section>

			<section class="manual-section" id="commands" aria-labelledby="synopsis-title">
				<div class="section-rail">
					<h2 id="synopsis-title">Commands</h2>
				</div>
				<div class="manual-body command-list">
					{
						commands.map((item) => (
							<div class="command-row">
								<Command command={item.command} />
								<p>{item.description}</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="manual-section" aria-labelledby="behavior-title">
				<div class="section-rail">
					<h2 id="behavior-title">Behavior</h2>
				</div>
				<dl class="manual-body behavior-list">
					{
						behavior.map(([term, description]) => (
							<div>
								<dt>{term}</dt>
								<dd>{description}</dd>
							</div>
						))
					}
				</dl>
			</section>

			<section class="manual-section" aria-labelledby="auth-title">
				<div class="section-rail">
					<h2 id="auth-title">Authentication</h2>
				</div>
				<div class="manual-body auth-body">
					<p class="definition">
						Authorization opens in the browser. The CLI receives the result and stores the
						refresh token in the operating system credential manager.
					</p>
					<div class="auth-facts">
						<p><span>YouTube</span> Read-only channel, broadcast, and live chat access.</p>
						<p><span>Twitch</span> <code>user:read:chat</code> only.</p>
						<p><span>Authentication server</span> OAuth sessions expire after five minutes.</p>
						<p><span>Chat data</span> Kept in process memory; discarded on exit.</p>
					</div>
					<a href="/privacy">Read the privacy policy</a>
				</div>
			</section>
		</div>

		<section class="end-block" aria-labelledby="end-title">
			<div>
				<p>Install</p>
				<h2 id="end-title">Install livefeed.</h2>
			</div>
			<Command command="bun add --global livefeed" label="Copy install command" large />
		</section>
	</main>

	<SiteFooter />
</Layout>

<style>
	main {
		width: min(100%, var(--page-width));
		margin-inline: auto;
	}

  .masthead,
  .manual-section,
  .end-block {
    padding-inline: var(--page-gutter);
  }

  .masthead {
    display: grid;
    grid-template-columns: minmax(24rem, 0.76fr) minmax(38rem, 1.35fr);
    gap: clamp(3rem, 5vw, 6rem);
    align-items: stretch;
    padding-top: clamp(2.75rem, 3vw, 3.75rem);
    padding-bottom: clamp(4.5rem, 7vw, 7.5rem);
    border-bottom: 1px solid var(--line);
  }

  .hero-intro {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  h1 {
    margin: clamp(1.75rem, 3vw, 3rem) 0 clamp(2rem, 4vw, 3.5rem);
    font-size: clamp(7rem, 12vw, 13rem);
    font-stretch: 62%;
    font-weight: 760;
    letter-spacing: -0.07em;
    line-height: 0.72;
  }

  h1 span {
    display: block;
  }

  h1 span:last-child {
    margin-top: 0.08em;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
  }

  .coordinate,
  .hero-install > p,
	.section-rail,
	.end-block > div > p {
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.07em;
	}

  .coordinate {
    display: inline-flex;
    width: fit-content;
    min-height: 2rem;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.5rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--line-strong);
    color: var(--accent);
    background: var(--surface);
    text-transform: uppercase;
  }

  .coordinate span {
    width: 0.38rem;
    height: 0.38rem;
    margin-right: 0.48rem;
    background: var(--accent);
    box-shadow: 0.52rem 0 0 var(--line-strong);
  }

  .hero-copy {
    max-width: 28rem;
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(0.92rem, 1.2vw, 1.08rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero-install {
    width: 100%;
    min-width: 0;
    margin-top: auto;
    padding-top: clamp(3rem, 6vw, 5rem);
  }

	.hero-install > p {
		margin: 0 0 0.75rem;
		color: var(--ink-muted);
	}

  .manual-section {
    display: grid;
    grid-template-columns: minmax(10rem, 0.22fr) minmax(0, 1fr);
  }

	.section-rail {
		padding-right: 2rem;
		color: var(--ink-muted);
	}

	.section-rail h2 {
		margin: 0;
		font-family: inherit;
		font-size: inherit;
		font-weight: 500;
		letter-spacing: inherit;
	}

  .hero-preview {
    min-width: 0;
    align-self: start;
    margin-top: calc(3.5rem + clamp(1.75rem, 3vw, 3rem));
    border-block: 1px solid var(--line);
  }

	.manual-section {
		border-bottom: 1px solid var(--line);
	}

	.manual-section .section-rail,
	.manual-body {
		padding-top: clamp(3rem, 6vw, 6rem);
		padding-bottom: clamp(4rem, 8vw, 8rem);
	}

	.manual-body {
		border-left: 1px solid var(--line);
		padding-left: clamp(1.5rem, 4vw, 4rem);
	}

	.name-body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.35fr);
		gap: clamp(3rem, 8vw, 9rem);
	}

	.definition {
		max-width: 50rem;
		margin: 0;
		font-size: clamp(1.8rem, 4vw, 4rem);
		font-stretch: 80%;
		font-weight: 430;
		letter-spacing: -0.035em;
		line-height: 1.08;
	}

	.name-body > p:last-child,
	.command-row > p,
	.behavior-list dd,
	.auth-facts p {
		color: var(--ink-muted);
		font-size: 0.82rem;
		line-height: 1.65;
	}

	.name-body > p:last-child {
		margin: 0;
	}

	.command-list {
		display: grid;
	}

	.command-row {
		display: grid;
		grid-template-columns: minmax(18rem, 0.8fr) 1fr;
		gap: clamp(2rem, 6vw, 7rem);
		align-items: center;
		padding-block: 1rem;
		border-top: 1px solid var(--line);
	}

	.command-row:last-child {
		border-bottom: 1px solid var(--line);
	}

	.command-row > p {
		margin: 0;
	}

	.behavior-list {
		margin: 0;
	}

	.behavior-list div {
		display: grid;
		grid-template-columns: minmax(8rem, 0.25fr) 1fr;
		gap: 2rem;
		padding-block: 1.25rem;
		border-top: 1px solid var(--line);
	}

	.behavior-list div:last-child {
		border-bottom: 1px solid var(--line);
	}

	.behavior-list dt,
	.auth-facts span {
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.06em;
	}

	.behavior-list dd {
		max-width: 48rem;
		margin: 0;
	}

	.auth-body .definition {
		margin-bottom: clamp(3rem, 7vw, 6rem);
	}

	.auth-facts {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		border-top: 1px solid var(--line);
	}

	.auth-facts p {
		margin: 0;
		padding: 1.25rem 1.25rem 1.25rem 0;
		border-bottom: 1px solid var(--line);
	}

	.auth-facts p:nth-child(odd) {
		border-right: 1px solid var(--line);
	}

	.auth-facts p:nth-child(even) {
		padding-left: 1.25rem;
	}

	.auth-facts span {
		display: block;
		margin-bottom: 0.65rem;
		color: var(--ink);
	}

	.auth-body > a {
		display: inline-block;
		margin-top: 3rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.06em;
		text-decoration: none;
	}

	.end-block {
		display: grid;
		grid-template-columns: 1fr minmax(20rem, 0.7fr);
		gap: clamp(3rem, 8vw, 9rem);
		align-items: end;
		padding-top: clamp(5rem, 10vw, 10rem);
		padding-bottom: clamp(5rem, 10vw, 10rem);
	}

	.end-block > div > p {
		margin: 0 0 1.5rem;
		color: var(--accent);
	}

	.end-block h2 {
		margin: 0;
		font-size: clamp(3.5rem, 8vw, 8rem);
		font-stretch: 67%;
		font-weight: 750;
		letter-spacing: -0.055em;
		line-height: 0.82;
	}

  @media (max-width: 68rem) {
    .masthead {
      grid-template-columns: minmax(18rem, 0.68fr) minmax(28rem, 1fr);
      gap: clamp(2rem, 4vw, 3rem);
    }

    h1 {
      font-size: clamp(6rem, 12vw, 9rem);
    }

    .manual-section {
      grid-template-columns: minmax(7rem, 0.18fr) minmax(0, 1fr);
		}

		.name-body,
		.end-block {
			grid-template-columns: 1fr;
		}
	}

  @media (max-width: 45rem) {
    .masthead {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: clamp(2.5rem, 7vw, 3.25rem);
    }

    .hero-install {
      margin-top: 0;
      padding-top: 2.5rem;
    }

    .hero-preview {
      margin-top: 0;
    }

    h1 {
      font-size: clamp(6rem, 30vw, 10rem);
    }

    .manual-section {
      grid-template-columns: 1fr;
		}

		.section-rail {
			display: flex;
			gap: 1rem;
			padding: 1rem 0;
			border-bottom: 1px solid var(--line);
		}

		.manual-body {
			padding-left: 0;
			border-left: 0;
		}

		.command-row {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.auth-facts {
			grid-template-columns: 1fr;
		}

		.auth-facts p:nth-child(odd) {
			border-right: 0;
		}

		.auth-facts p:nth-child(even) {
			padding-left: 0;
		}
	}

  @media (max-width: 28rem) {
    h1 {
      font-size: clamp(5rem, 29vw, 7.5rem);
    }

		.behavior-list div {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.end-block h2 {
			font-size: clamp(3.2rem, 17vw, 5rem);
		}
	}
</style>
