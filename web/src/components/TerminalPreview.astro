---
const messages = [
  { author: "bytebloom", message: "audio is clean now", color: "cyan" },
  { author: "orbitalecho", message: "does this pick up unlisted streams?", color: "purple" },
  { author: "dipxsy", message: "yes, visibility does not matter", color: "blue" },
  { author: "pixelharbor", message: "the terminal view is much easier to follow", color: "green" },
  { author: "sleepycompiler", message: "chat history loaded too?", color: "pink" },
  { author: "dipxsy", message: "yep, then it follows new messages", color: "blue" },
  { author: "limewireframe", message: "this is staying open on the second monitor", color: "gold" },
  { author: "staticgarden", message: "love how quiet the interface feels", color: "cyan" },
  { author: "softpacket", message: "does it reconnect on its own?", color: "purple" },
  { author: "dipxsy", message: "automatically, messages stay right here", color: "blue" },
  { author: "moonlitcache", message: "shipping this for tonight's stream", color: "green" },
  { author: "tinydaemon", message: "exactly what my second monitor needed", color: "pink" },
] as const;
---

<figure class="terminal" aria-label="Accurate preview of Livefeed displaying YouTube chat">
  <p class="status">
    <span aria-hidden="true">●</span> connected<span class="status-detail">
      · Building livefeed · q quit</span
    >
  </p>

  <div class="messages">
    {
      messages.map((message) => (
        <div class="message-slot" data-chat-message>
          <p class="message">
            <strong class={message.color}>{message.author}</strong>
            <span class="separator">: </span>
            {message.message}
          </p>
        </div>
      ))
    }
  </div>
</figure>

<script>
  const delay = (milliseconds: number) =>
    new Promise<void>((resolve) => window.setTimeout(resolve, milliseconds));

  for (const terminal of document.querySelectorAll<HTMLElement>(".terminal")) {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const messages = [...terminal.querySelectorAll<HTMLElement>("[data-chat-message]")];

    if (prefersReducedMotion.matches || messages.length === 0) continue;

    terminal.dataset.animated = "true";

    const play = async () => {
      while (terminal.isConnected && !prefersReducedMotion.matches) {
        for (const message of messages) {
          message.dataset.visible = "true";
          await delay(560);
        }

        await delay(1800);
        terminal.dataset.resetting = "true";

        for (const message of messages) {
          delete message.dataset.visible;
        }

        await delay(160);
        delete terminal.dataset.resetting;
      }

      for (const message of messages) {
        message.dataset.visible = "true";
      }
    };

    void play();
  }
</script>

<style>
  .terminal {
    --cli-primary: #d9dbea;
    --cli-muted: #777f96;
    --cli-connected: #7187ff;
    --author-cyan: #79c7c5;
    --author-purple: #c9a7eb;
    --author-blue: #8fb8e8;
    --author-green: #93c47d;
    --author-pink: #e3a6b8;
    --author-gold: #d6b86a;
    display: flex;
    min-height: clamp(22rem, min(32vw, 55vh), 30rem);
    height: 100%;
    flex-direction: column;
    margin: 0;
    padding: clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
    color: var(--cli-primary);
    background: transparent;
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1vw, 0.86rem);
    line-height: 1.7;
  }

  :global(html[data-theme="light"]) .terminal {
    --cli-primary: #242424;
    --cli-muted: #656565;
    --cli-connected: #3553ff;
    --author-cyan: #006b68;
    --author-purple: #6f42a6;
    --author-blue: #265f9e;
    --author-green: #39752a;
    --author-pink: #9b3f62;
    --author-gold: #806300;
  }

  .status {
    margin: 0;
    color: var(--cli-connected);
  }

  .messages {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 3rem;
    overflow: hidden;
  }

  .message-slot {
    display: grid;
    grid-template-rows: 1fr;
  }

  .message-slot > .message {
    min-height: 0;
    overflow: hidden;
  }

  .message {
    margin: 0;
    color: var(--cli-primary);
  }

  .terminal[data-animated] .message-slot {
    grid-template-rows: 0fr;
    transition: grid-template-rows 420ms var(--ease-out);
  }

  .terminal[data-animated] .message-slot .message {
    opacity: 0;
    transform: translateY(0.45rem);
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out);
  }

  .terminal[data-animated] .message-slot[data-visible] {
    grid-template-rows: 1fr;
  }

  .terminal[data-animated] .message-slot[data-visible] .message {
    opacity: 1;
    transform: translateY(0);
  }

  .terminal[data-resetting] .message-slot,
  .terminal[data-resetting] .message-slot .message {
    transition-duration: 0ms;
  }

  .message strong {
    font-weight: 500;
  }

  .separator {
    color: var(--cli-muted);
  }

  .cyan {
    color: var(--author-cyan);
  }

  .purple {
    color: var(--author-purple);
  }

  .blue {
    color: var(--author-blue);
  }

  .green {
    color: var(--author-green);
  }

  .pink {
    color: var(--author-pink);
  }

  .gold {
    color: var(--author-gold);
  }

  @media (max-width: 64rem) {
    .status-detail {
      display: none;
    }
  }

  @media (max-width: 45rem) {
    .terminal {
      min-height: 23rem;
      padding-inline: 0;
    }
  }
</style>
