{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "livefeed-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "livefeed-auth.dipxsy.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OAUTH_SESSIONS",
        "class_name": "OAuthSession"
      },
      {
        "name": "TWITCH_OAUTH_SESSIONS",
        "class_name": "TwitchOAuthSession"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "152001",
      "simple": {
        "limit": 3000,
        "period": 60
      }
    },
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "152002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "POLL_RATE_LIMITER",
      "namespace_id": "152003",
      "simple": {
        "limit": 90,
        "period": 60
      }
    },
    {
      "name": "REFRESH_RATE_LIMITER",
      "namespace_id": "152004",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "exports": {
    "OAuthSession": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "TwitchOAuthSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
