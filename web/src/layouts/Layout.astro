---
type Props = {
  title: string;
  description: string;
  robots?: string;
};

const { title, description, robots = "index, follow" } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL("/og-livefeed.png", canonicalUrl);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content="#fafaf5" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Livefeed" />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Livefeed | YouTube, Twitch, and Kick chat in your terminal"
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta
			name="twitter:image:alt"
			content="Livefeed | YouTube, Twitch, and Kick chat in your terminal"
		/>
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Spline+Sans+Mono:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			(() => {
				const preferredTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
					? "dark"
					: "light";
				try {
					const storedTheme = localStorage.getItem("livefeed-theme");
					document.documentElement.dataset.theme =
						storedTheme === "light" || storedTheme === "dark" ? storedTheme : preferredTheme;
				} catch {
					document.documentElement.dataset.theme = preferredTheme;
				}
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--canvas: #fafaf5;
		--surface: #f0eee3;
		--surface-muted: #e8e5d8;
		--ink: #252525;
		--ink-muted: #73736e;
		--line: #d9d8d0;
		--line-strong: #a7a69e;
		--grid-dot: rgb(53 83 255 / 12%);
		--accent: #3553ff;
		--accent-dark: #263fd4;
		--terminal: var(--canvas);
		--terminal-muted: var(--ink-muted);
		--terminal-line: var(--line);
		--font-sans: "Spline Sans Mono", "SFMono-Regular", Consolas, monospace;
		--font-mono: "Spline Sans Mono", "SFMono-Regular", Consolas, monospace;
		--ease-out: cubic-bezier(0.22, 1, 0.36, 1);
		--page-gutter: clamp(1rem, 3vw, 3rem);
		--page-width: 78rem;
		font-family: var(--font-sans);
		color: var(--ink);
		background: var(--canvas);
		font-synthesis: none;
		text-rendering: optimizeLegibility;
	}

	:root[data-theme="dark"] {
		color-scheme: dark;
		--canvas: #11120f;
		--surface: #1b1c18;
		--surface-muted: #24251f;
		--ink: #efeee7;
		--ink-muted: #9b9a92;
		--line: #32332d;
		--line-strong: #5b5c54;
		--grid-dot: rgb(111 133 255 / 14%);
		--accent: #7187ff;
		--accent-dark: #5870f2;
	}

	:root[data-theme="light"] {
		color-scheme: light;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 2rem;
		scrollbar-width: none;
	}

	html::-webkit-scrollbar {
		display: none;
	}

	body {
		min-width: 20rem;
		margin: 0;
		background-color: var(--canvas);
		background-image: radial-gradient(circle, var(--grid-dot) 0.65px, transparent 0.75px);
		background-size: 10px 10px;
		-webkit-font-smoothing: antialiased;
	}

	button,
	a {
		-webkit-tap-highlight-color: transparent;
	}

	a {
		color: inherit;
	}

	::selection {
		color: var(--canvas);
		background: var(--accent);
	}

	.skip-link {
		position: fixed;
		z-index: 20;
		top: 0.75rem;
		left: 0.75rem;
		padding: 0.75rem 1rem;
		color: var(--surface);
		background: var(--ink);
		transform: translateY(-200%);
		transition: transform 180ms var(--ease-out);
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	:focus-visible {
		outline: 1px solid var(--accent);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
