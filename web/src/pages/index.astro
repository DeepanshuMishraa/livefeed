---
import Command from "../components/Command.astro";
import InstallCommands from "../components/InstallCommands.astro";
import ProviderSignal from "../components/ProviderSignal.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TerminalPreview from "../components/TerminalPreview.astro";
import Layout from "../layouts/Layout.astro";
import packageJson from "../../../package.json";

const commands = [
  { command: "livefeed", description: "Open the connected chat or choose a provider" },
  { command: "livefeed auth", description: "Choose YouTube, Twitch, or Kick and connect" },
  { command: "livefeed logout", description: "Remove one login or sign out of all providers" },
  { command: "livefeed update", description: "Install the latest published version" },
] as const;

const statusRows = [
  { label: "Providers", value: "3 / 3", measure: "100%" },
  { label: "Write access", value: "0", measure: "0%" },
  { label: "Local history", value: "2,000", measure: "82%" },
  { label: "Analytics", value: "none", measure: "0%" },
] as const;

const authFacts = [
  [
    "AUTH_001",
    "YouTube",
    "Finds public, unlisted, and private live broadcasts with read-only access.",
  ],
  ["AUTH_002", "Twitch", "Uses user:read:chat to receive your channel's live conversation."],
  ["AUTH_003", "Kick", "Receives signed chat events through Livefeed's read-only relay."],
  ["AUTH_004", "Credentials", "Refresh tokens stay in the operating system credential manager."],
  ["AUTH_005", "Chat data", "YouTube and Twitch messages stay local. Kick events cross the relay."],
] as const;
---

<Layout
	title="Livefeed | YouTube, Twitch, and Kick chat in your terminal"
	description="Livefeed is a read-only CLI that finds your active YouTube, Twitch, or Kick stream and displays its live chat in the terminal."
>
	<SiteHeader />

	<main id="main-content">
		<section class="hero" id="product" aria-labelledby="hero-title">
			<div class="figure-meta">
				<p>OPEN SOURCE · MIT</p>
			</div>

			<h1 id="hero-title">LIVE CHAT<br />FROM TERMINAL</h1>

			<div class="hero-summary">
				<div>
					<p class="hero-thesis">
						YouTube, Twitch, and Kick chat, kept beside the code instead of behind another browser
						window.
					</p>
					<p class="hero-note">
						Read-only. Automatic stream discovery. Built to stay open on your own machine.
					</p>
				</div>
				<div class="hero-actions">
					<a class="primary-action" href="#install">Install Livefeed</a>
					<a href="https://github.com/DeepanshuMishraa/livefeed">View source</a>
				</div>
			</div>
		</section>

		<section class="product-figure" aria-labelledby="preview-title">
			<header class="section-caption">
				<p id="preview-title">FIG_001 · LIVE TERMINAL FEED</p>
				<p>Newest messages remain anchored at the bottom</p>
			</header>
			<div class="figure-stage">
				<div class="chat-panel">
					<TerminalPreview />
				</div>
				<ProviderSignal />
			</div>
		</section>

		<section class="editorial-section" aria-labelledby="how-title">
			<div class="section-label">
				<p>HOW THIS WORKS</p>
			</div>
			<div class="editorial-copy">
				<h2 id="how-title">One command. The active conversation.</h2>
				<p class="lead">
					Livefeed checks which provider is connected, finds the broadcast that is live now,
					and opens its chat in a responsive terminal feed.
				</p>
				<div class="copy-columns">
					<p>
						Start it before going live. It waits offline, checks again, and connects without a
						restart. If multiple providers are connected, a compact shell prompt asks
						which chat to open.
					</p>
					<p>
						YouTube history loads before new messages arrive. Twitch history is restored from
						the local machine. Network loss is reported, retries are automatic, and messages
						already received stay visible.
					</p>
				</div>
			</div>
		</section>

		<section class="status-section" aria-labelledby="status-title">
			<h2 id="status-title">Operational profile</h2>
			<div class="status-list">
				{
					statusRows.map((row) => (
						<div class="status-row">
							<p>{row.label}</p>
							<div class="status-track" aria-hidden="true">
								<span style={`--measure: ${row.measure}`}></span>
							</div>
							<p>{row.value}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="catalog" id="commands" aria-labelledby="commands-title">
			<header class="catalog-heading">
				<p>COMMAND CATALOG · {commands.length} ENTRIES</p>
				<h2 id="commands-title">Run the feed</h2>
				<p>Copy a command or run the default. Provider-specific commands remain available.</p>
			</header>

			<div class="catalog-rows">
				{
					commands.map((item, index) => (
						<div class="catalog-row">
							<span class="row-index">{index}.</span>
							<span class="row-marker" aria-hidden="true"></span>
							<Command command={item.command} />
							<p>{item.description}</p>
							<span class="row-code">0{index}</span>
						</div>
					))
				}
			</div>
		</section>

		<section class="install-section" id="install" aria-labelledby="install-title">
			<div class="section-label">
				<p>INSTALL · THREE PACKAGE MANAGERS</p>
			</div>
			<div class="install-content">
				<h2 id="install-title">Install once. Run anywhere Bun runs.</h2>
				<p>
					Use npm, pnpm, or Bun to install the public package globally. Bun 1.3 or newer is
					required as the runtime on macOS or desktop Linux.
				</p>
				<InstallCommands id="main-install" version={packageJson.version} />
			</div>
		</section>

		<section class="auth-section" aria-labelledby="auth-title">
			<header class="catalog-heading">
				<p>AUTHORIZATION · READ ONLY</p>
				<h2 id="auth-title">Access with strict boundaries</h2>
				<p>Browser authorization completes once. Provider secrets never ship in the CLI.</p>
			</header>
			<div class="auth-grid">
				{
					authFacts.map(([index, title, description]) => (
						<article>
							<p>{index}</p>
							<h3>{title}</h3>
							<p>{description}</p>
						</article>
					))
				}
			</div>
		</section>

		<section class="colophon" aria-labelledby="colophon-title">
			<div class="section-label">
				<p>COLOPHON</p>
			</div>
			<div>
				<h2 id="colophon-title">Your stream stays yours.</h2>
				<p>
					No analytics. No advertising. Kick's signed webhook relay carries only the chat
					required by the terminal feed. The source is public and the license is MIT.
				</p>
				<Command command="livefeed" label="Copy launch command" large />
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>

<style>
	main {
		width: min(100%, var(--page-width));
		margin-inline: auto;
		padding-inline: var(--page-gutter);
	}

	.hero {
		padding-block: clamp(2.25rem, 6vw, 5.5rem) clamp(4rem, 9vw, 7.5rem);
		border-bottom: 1px solid var(--line);
	}

	.figure-meta,
	.section-caption,
	.launch-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		color: var(--accent);
		font-size: 0.58rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.figure-meta {
		justify-content: flex-end;
	}

	.figure-meta p,
	.section-caption p {
		margin: 0;
	}

	h1 {
		max-width: 64rem;
		margin: clamp(2rem, 6vw, 5rem) 0 clamp(2rem, 5vw, 4rem);
		color: var(--accent);
		font-size: clamp(4rem, 9vw, 8rem);
		font-weight: 700;
		letter-spacing: -0.075em;
		line-height: 0.88;
		text-transform: uppercase;
	}

	.hero-summary {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: clamp(2rem, 6vw, 6rem);
		align-items: end;
	}

	.hero-thesis {
		max-width: 48rem;
		margin: 0 0 0.75rem;
		color: var(--ink);
		font-size: clamp(1rem, 1.7vw, 1.3rem);
		line-height: 1.55;
	}

	.hero-note {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.72rem;
		font-style: italic;
		line-height: 1.6;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.hero-actions a {
		display: inline-flex;
		min-height: 2.8rem;
		align-items: center;
		justify-content: center;
		padding-inline: 1rem;
		border: 1px solid var(--accent);
		color: var(--accent);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			color 140ms var(--ease-out),
			background-color 140ms var(--ease-out);
	}

	.hero-actions .primary-action {
		color: var(--canvas);
		background: var(--accent);
	}

	.product-figure {
		padding-block: clamp(2.5rem, 6vw, 5rem);
		border-bottom: 1px solid var(--line);
	}

	.section-caption {
		padding-bottom: 1rem;
	}

	.section-caption p:last-child {
		color: var(--ink-muted);
		font-weight: 400;
	}

	.figure-stage {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) clamp(18rem, 30vw, 24rem);
	}

	.chat-panel {
		min-width: 0;
	}

	.product-figure :global(.terminal) {
		min-height: clamp(26rem, 52vw, 37rem);
		padding: clamp(1rem, 3vw, 2rem) 0 0;
		font-size: clamp(0.75rem, 1.25vw, 0.95rem);
	}

	.editorial-section,
	.install-section,
	.colophon {
		display: grid;
		grid-template-columns: minmax(9rem, 0.28fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 6rem);
		padding-block: clamp(4rem, 9vw, 7.5rem);
		border-bottom: 1px solid var(--line);
	}

	.section-label p,
	.catalog-heading > p:first-child,
	.status-section > h2 {
		margin: 0;
		color: var(--accent);
		font-size: 0.58rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.editorial-copy h2,
	.install-content h2,
	.catalog-heading h2,
	.colophon h2 {
		margin: 0 0 1.5rem;
		font-size: clamp(1.8rem, 4vw, 3.6rem);
		font-weight: 650;
		letter-spacing: -0.055em;
		line-height: 1;
		text-transform: uppercase;
	}

	.editorial-copy .lead {
		max-width: 48rem;
		margin: 0 0 clamp(2rem, 5vw, 4rem);
		color: var(--ink);
		font-size: clamp(1rem, 1.6vw, 1.25rem);
		line-height: 1.65;
	}

	.copy-columns {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border-top: 1px solid var(--line);
	}

	.copy-columns p {
		margin: 0;
		padding: 1.5rem 1.5rem 0 0;
		color: var(--ink-muted);
		font-size: 0.82rem;
		line-height: 1.75;
	}

	.copy-columns p + p {
		padding-left: 1.5rem;
		border-left: 1px solid var(--line);
	}

	.status-section {
		display: grid;
		grid-template-columns: minmax(9rem, 0.28fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 6rem);
		padding-block: clamp(3rem, 7vw, 5.5rem);
		border-bottom: 1px solid var(--line);
	}

	.status-list {
		display: grid;
		gap: 1rem;
	}

	.status-row {
		display: grid;
		grid-template-columns: minmax(8rem, 0.3fr) minmax(10rem, 1fr) 5rem;
		gap: 1.5rem;
		align-items: center;
		font-size: 0.66rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.status-row p {
		margin: 0;
	}

	.status-row p:last-child {
		text-align: right;
	}

	.status-track {
		height: 0.65rem;
		background: var(--surface-muted);
	}

	.status-track span {
		display: block;
		width: var(--measure);
		height: 100%;
		background: var(--accent);
	}

	.catalog,
	.auth-section {
		padding-block: clamp(4rem, 9vw, 7.5rem);
		border-bottom: 1px solid var(--line);
	}

	.catalog-heading {
		margin-bottom: clamp(2.5rem, 6vw, 5rem);
	}

	.catalog-heading h2 {
		margin-top: 1rem;
	}

	.catalog-heading > p:last-child,
	.install-content > p,
	.colophon > div:last-child > p {
		max-width: 52rem;
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.82rem;
		line-height: 1.7;
	}

	.catalog-rows {
		border-top: 1px solid var(--line);
	}

	.catalog-row {
		display: grid;
		grid-template-columns: 2.2rem 0.6rem minmax(18rem, 0.75fr) minmax(13rem, 1fr) 2rem;
		gap: 1rem;
		align-items: center;
		min-height: 5rem;
		border-bottom: 1px solid var(--line);
	}

	.row-index,
	.row-code {
		color: var(--accent);
		font-size: 0.62rem;
	}

	.row-code {
		color: var(--ink-muted);
		text-align: right;
	}

	.row-marker {
		width: 0.5rem;
		height: 0.5rem;
		background: var(--accent);
	}

	.catalog-row > p {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.72rem;
		line-height: 1.55;
	}

	.catalog-row :global(.command) {
		border: 0;
		background: transparent;
	}

	.install-content > p {
		margin-bottom: 2rem;
	}

	.auth-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border-top: 1px solid var(--line);
	}

	.auth-grid article {
		padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.25rem);
		border-bottom: 1px solid var(--line);
	}

	.auth-grid article:nth-child(odd) {
		border-right: 1px solid var(--line);
	}

	.auth-grid article:nth-child(5) {
		grid-column: 1 / -1;
		border-right: 0;
	}

	.auth-grid article > p:first-child {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.58rem;
		font-weight: 600;
		letter-spacing: 0.08em;
	}

	.auth-grid h3 {
		margin: 0 0 0.5rem;
		font-size: 0.82rem;
		font-weight: 650;
		text-transform: uppercase;
	}

	.auth-grid article > p:last-child {
		margin: 0;
		max-width: 32rem;
		color: var(--ink-muted);
		font-size: 0.76rem;
		line-height: 1.6;
	}

	.colophon {
		border-bottom: 0;
	}

	.colophon > div:last-child > p {
		margin-bottom: 1.5rem;
	}

	.colophon :global(.command) {
		background: var(--surface);
	}

	@media (hover: hover) {
		.hero-actions a:hover {
			color: var(--canvas);
			background: var(--accent-dark);
		}
	}

	@media (max-width: 52rem) {
		.hero-summary,
		.editorial-section,
		.install-section,
		.status-section,
		.colophon {
			grid-template-columns: 1fr;
		}

		.hero-actions {
			justify-content: flex-start;
		}

		.catalog-row {
			grid-template-columns: 2rem 0.5rem minmax(0, 1fr) 2rem;
			padding-block: 0.75rem;
		}

		.catalog-row > p {
			grid-column: 3 / 4;
		}
	}

	@media (max-width: 38rem) {
		.figure-stage {
			grid-template-columns: 1fr;
		}

		.figure-meta,
		.section-caption {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.5rem;
		}

		h1 {
			font-size: clamp(3.2rem, 15vw, 5rem);
		}

		.hero-actions {
			align-items: stretch;
			flex-direction: column;
		}

		.copy-columns,
		.auth-grid {
			grid-template-columns: 1fr;
		}

		.auth-grid article:nth-child(odd) {
			border-right: 0;
		}

		.copy-columns p + p {
			padding-left: 0;
			border-left: 0;
		}

		.status-row {
			grid-template-columns: 1fr 4rem;
			gap: 0.65rem 1rem;
		}

		.status-track {
			grid-column: 1 / -1;
			grid-row: 2;
		}

		.catalog-row {
			grid-template-columns: 1.5rem 0.45rem minmax(0, 1fr);
			gap: 0.65rem;
		}

		.row-code {
			display: none;
		}

		.catalog-row :global(.command),
		.catalog-row > p {
			grid-column: 3;
		}
	}
</style>
