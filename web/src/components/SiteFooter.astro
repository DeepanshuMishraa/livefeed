---
import IconLink from "./IconLink.astro";
---

<footer class="site-footer">
	<p class="wordmark">livefeed</p>
	<nav aria-label="Footer navigation">
		<a href="/privacy">Privacy</a>
		<a href="/terms">Terms</a>
		<a href="https://github.com/DeepanshuMishraa/livefeed/issues">Contact</a>
		<IconLink href="https://www.npmjs.com/package/livefeed" label="npm" icon="npm" />
		<IconLink
			href="https://github.com/DeepanshuMishraa/livefeed"
			label="GitHub"
			icon="github"
		/>
	</nav>
	<p class="descriptor">MIT licensed</p>
</footer>

<style>
	.site-footer {
		display: grid;
		width: min(100%, var(--page-width));
		min-height: 8rem;
		grid-template-columns: 1fr auto 1fr;
		gap: 2rem;
		align-items: center;
		margin-inline: auto;
		padding-inline: var(--page-gutter);
		border-top: 1px solid var(--line);
		color: var(--ink-muted);
		font-family: var(--font-mono);
		font-size: 0.62rem;
	}

	p {
		margin: 0;
	}

	.wordmark {
		color: var(--ink);
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 650;
		letter-spacing: -0.02em;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(1rem, 2.5vw, 2rem);
	}

	nav > a {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		color: inherit;
		text-decoration: none;
		transition: color 150ms linear;
	}

	.descriptor {
		text-align: right;
	}

	@media (hover: hover) {
		nav > a:hover {
			color: var(--ink);
		}
	}

	@media (max-width: 50rem) {
		.site-footer {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding-block: 2.5rem;
		}

		nav {
			justify-content: flex-start;
			flex-wrap: wrap;
		}

		.descriptor {
			text-align: left;
		}
	}
</style>
