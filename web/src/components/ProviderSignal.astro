<style>
	.provider-graph {
		display: grid;
		min-width: 0;
		min-height: clamp(26rem, 52vw, 37rem);
		place-items: center;
	}

	.graph {
		display: grid;
		width: 100%;
		grid-template-rows: auto auto auto;
	}

	.livefeed-node {
		display: flex;
		min-height: 3.15rem;
		align-items: center;
		gap: 0.75rem;
		padding-inline: 1.1rem;
		color: var(--canvas);
		background: var(--accent);
		animation: livefeed-breathe 1.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
	}

	.livefeed-node span {
		width: 0.55rem;
		height: 0.55rem;
		background: currentColor;
	}

	.livefeed-node strong {
		font-size: 0.8rem;
		font-weight: 650;
		letter-spacing: 0.08em;
	}

	.connections {
		display: block;
		width: 100%;
		height: auto;
		fill: var(--accent);
	}

	.connection {
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.5;
		stroke-dasharray: 3 8;
		stroke-linecap: square;
		animation: signal-flow 1.8s linear infinite;
	}

	.connection-twitch {
		animation-delay: -0.9s;
	}

	.connection-kick {
		animation-delay: -0.45s;
	}

	.source-point {
		transform-box: fill-box;
		transform-origin: center;
		animation: merge-pulse 1.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
	}

	.provider-nodes {
		display: grid;
		width: 100%;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: start;
	}

	.node {
		display: grid;
		justify-items: center;
	}

	.brand-mark {
		display: block;
		height: auto;
	}

	.youtube-mark {
		width: 4.6rem;
	}

	.twitch-mark {
		width: 3.5rem;
	}

	.kick-mark {
		width: 5.2rem;
	}

	@keyframes signal-flow {
		to {
			stroke-dashoffset: -22;
		}
	}

	@keyframes merge-pulse {
		0%,
		55%,
		100% {
			opacity: 0.35;
			transform: scale(1);
		}
		70% {
			opacity: 1;
			transform: scale(1.8);
		}
	}

	@keyframes livefeed-breathe {
		0%,
		65%,
		100% {
			transform: scale(1);
		}
		75% {
			transform: scale(1.025);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.connection,
		.source-point,
		.livefeed-node {
			animation: none;
		}
	}

	@media (max-width: 38rem) {
