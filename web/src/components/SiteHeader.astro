---
import IconLink from "./IconLink.astro";
import ThemeToggle from "./ThemeToggle.astro";

type Props = {
  active?: "home" | "privacy" | "terms";
};

const { active = "home" } = Astro.props;
---

<header class="site-header">
	<a class="wordmark" href="/" aria-label="Livefeed home">
		<span aria-hidden="true"></span>
		LIVEFEED / TERMINAL CHAT
	</a>

	<nav aria-label="Primary navigation">
		<a href="/#product" aria-current={active === "home" ? "page" : undefined}>Product</a>
		<a href="/#commands">Commands</a>
		<a href="/#install">Install</a>
		<a href="/privacy" aria-current={active === "privacy" ? "page" : undefined}>Privacy</a>
		<a href="/terms" aria-current={active === "terms" ? "page" : undefined}>Terms</a>
		<IconLink
			href="https://github.com/DeepanshuMishraa/livefeed"
			label="GitHub"
			icon="github"
			iconOnly
		/>
		<ThemeToggle />
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		width: min(100%, var(--page-width));
		min-height: 4.25rem;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		margin-inline: auto;
		padding-inline: var(--page-gutter);
		border-bottom: 1px solid var(--line);
		font-size: 0.61rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.wordmark {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		gap: 0.7rem;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
	}

	.wordmark span {
		width: 0.52rem;
		height: 0.52rem;
		background: var(--accent);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: clamp(0.8rem, 2vw, 1.5rem);
	}

	nav > a {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		color: var(--ink-muted);
		text-decoration: none;
		transition: color 140ms var(--ease-out);
	}

	nav > a[aria-current="page"] {
		color: var(--accent);
	}

	@media (hover: hover) {
		nav > a:hover {
			color: var(--accent);
		}
	}

	@media (max-width: 50rem) {
		nav > a:nth-child(-n + 3) {
			display: none;
		}
	}

	@media (max-width: 34rem) {
		.site-header {
			min-height: 3.75rem;
		}

		.wordmark {
			font-size: 0;
		}

		.wordmark::after {
			font-size: 0.65rem;
			content: "LIVEFEED";
		}

		nav > a:nth-child(4) {
			display: none;
		}
	}
</style>
