---
const messages = [
  { author: "maya_dev", message: "audio is clean now", color: "cyan" },
  { author: "northstar", message: "does this pick up unlisted streams?", color: "purple" },
  { author: "dipxsy", message: "yes — visibility does not matter", color: "blue" },
  { author: "buildwithsam", message: "the terminal view is much easier to follow", color: "green" },
  { author: "nulladdict", message: "chat history loaded too?", color: "pink" },
  { author: "dipxsy", message: "yep, then it follows new messages", color: "blue" },
  { author: "cosmastech", message: "this is staying open on the second monitor", color: "gold" },
] as const;
---

<figure class="terminal" aria-label="Accurate preview of Livefeed displaying YouTube chat">
  <p class="status">
    <span aria-hidden="true">●</span> connected<span class="status-detail">
      · Building livefeed · q quit</span
    >
  </p>

  <div class="messages">
    {
      messages.map((message, index) => (
        <p class="message" style={`--row: ${index}`}>
          <strong class={message.color}>{message.author}</strong>
          <span class="separator">: </span>
          {message.message}
        </p>
      ))
    }
  </div>
</figure>

<style>
  .terminal {
    --cli-primary: #d9dbea;
    --cli-muted: #777f96;
    --cli-connected: #78c7a3;
    --author-cyan: #79c7c5;
    --author-purple: #c9a7eb;
    --author-blue: #8fb8e8;
    --author-green: #93c47d;
    --author-pink: #e3a6b8;
    --author-gold: #d6b86a;
    display: flex;
    min-height: clamp(24rem, min(32vw, 55vh), 30rem);
    flex-direction: column;
    margin: 0;
    padding: clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
    color: var(--cli-primary);
    background: transparent;
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1vw, 0.86rem);
    line-height: 1.7;
  }

  :global(html[data-theme="light"]) .terminal {
    --cli-primary: #242424;
    --cli-muted: #656565;
    --cli-connected: #247653;
    --author-cyan: #006b68;
    --author-purple: #6f42a6;
    --author-blue: #265f9e;
    --author-green: #39752a;
    --author-pink: #9b3f62;
    --author-gold: #806300;
  }

  .status {
    margin: 0;
    color: var(--cli-connected);
  }

  .messages {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 3rem;
  }

  .message {
    margin: 0;
    color: var(--cli-primary);
    animation: row-in 420ms var(--ease-out) both;
    animation-delay: calc(120ms + var(--row) * 70ms);
  }

  .message strong {
    font-weight: 500;
  }

  .separator {
    color: var(--cli-muted);
  }

  .cyan {
    color: var(--author-cyan);
  }

  .purple {
    color: var(--author-purple);
  }

  .blue {
    color: var(--author-blue);
  }

  .green {
    color: var(--author-green);
  }

  .pink {
    color: var(--author-pink);
  }

  .gold {
    color: var(--author-gold);
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(0.45rem);
    }
  }

  @media (max-width: 64rem) {
    .status-detail {
      display: none;
    }
  }

  @media (max-width: 45rem) {
    .terminal {
      min-height: 23rem;
      padding-inline: 0;
    }
  }
</style>
