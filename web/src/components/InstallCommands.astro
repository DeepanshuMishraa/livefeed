---
import Command from "./Command.astro";

type Props = {
  id: string;
  version: string;
};

const { id, version } = Astro.props;

const installers = [
  { name: "npm", command: "npm install --global livefeed" },
  { name: "pnpm", command: "pnpm add --global livefeed" },
  { name: "bun", command: "bun add --global livefeed" },
] as const;
---

<div class="install-panel" data-install-tabs>
	<div class="install-meta">
		<p><span class="status-dot" aria-hidden="true"></span>Install Livefeed</p>
		<p><span>v{version}</span><span class="runtime">Requires Bun 1.3+</span></p>
	</div>

	<div class="install-tabs" role="tablist" aria-label="Package manager">
		{
			installers.map((installer, index) => (
				<button
					type="button"
					role="tab"
					id={`${id}-${installer.name}-tab`}
					aria-controls={`${id}-${installer.name}-panel`}
					aria-selected={index === 0 ? "true" : "false"}
					tabindex={index === 0 ? 0 : -1}
					class="install-tab"
					data-install-tab
				>
					{installer.name}
				</button>
			))
		}
	</div>

	{
		installers.map((installer, index) => (
			<div
				class="install-command"
				role="tabpanel"
				id={`${id}-${installer.name}-panel`}
				aria-labelledby={`${id}-${installer.name}-tab`}
				hidden={index !== 0}
				data-install-panel
			>
				<Command
					command={installer.command}
					label={`Copy ${installer.name} install command`}
					large
				/>
			</div>
		))
	}

	<p class="update-note">
		<span>POST INSTALL</span> Keep Livefeed current with <code>livefeed update</code>
	</p>
</div>

<script>
	for (const container of document.querySelectorAll<HTMLElement>("[data-install-tabs]")) {
		const tabs = [...container.querySelectorAll<HTMLButtonElement>("[data-install-tab]")];
		const panels = [...container.querySelectorAll<HTMLElement>("[data-install-panel]")];

		const selectTab = (selectedIndex: number, moveFocus: boolean) => {
			for (const [index, tab] of tabs.entries()) {
				const selected = index === selectedIndex;
				tab.setAttribute("aria-selected", String(selected));
				tab.tabIndex = selected ? 0 : -1;
				if (selected && moveFocus) tab.focus();
			}

			for (const [index, panel] of panels.entries()) {
				panel.hidden = index !== selectedIndex;
			}
		};

		for (const [index, tab] of tabs.entries()) {
			tab.addEventListener("click", () => selectTab(index, false));
			tab.addEventListener("keydown", (event) => {
				if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
				event.preventDefault();
				const direction = event.key === "ArrowRight" ? 1 : -1;
				selectTab((index + direction + tabs.length) % tabs.length, true);
			});
		}
	}
</script>

<style>
	.install-panel {
		width: 100%;
		border: 1px solid var(--line-strong);
	}

	.install-meta {
		display: flex;
		min-height: 2.5rem;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-inline: clamp(0.85rem, 2vw, 1.25rem);
		color: var(--ink-muted);
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.install-meta p {
		display: flex;
		align-items: center;
		gap: clamp(0.65rem, 2vw, 1.25rem);
		margin: 0;
	}

	.install-meta p:last-child span:first-child {
		color: var(--accent);
	}

	.status-dot {
		width: 0.38rem;
		height: 0.38rem;
		background: var(--accent);
	}

	.install-tabs {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.install-tab {
		position: relative;
		display: flex;
		min-width: 0;
		min-height: 2.6rem;
		align-items: center;
		justify-content: center;
		padding: 0.5rem 0.75rem;
		appearance: none;
		border: 0;
		border-right: 1px solid var(--line);
		border-radius: 0;
		color: var(--ink-muted);
		background: transparent;
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		transition:
			color 160ms var(--ease-out),
			background-color 160ms var(--ease-out);
	}

	.install-tab:last-child {
		border-right: 0;
	}

	.install-tab[aria-selected="true"] {
		color: var(--canvas);
		background: var(--accent);
	}

	.install-command[hidden] {
		display: none;
	}

	.install-command :global(.command) {
		min-height: clamp(4rem, 8vh, 4.75rem);
		border: 0;
		background: transparent;
	}

	.update-note {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0;
		padding: 0.85rem clamp(0.85rem, 2vw, 1.25rem);
		border-top: 1px solid var(--line);
		color: var(--ink-muted);
		font-size: 0.62rem;
		line-height: 1.5;
	}

	.update-note span,
	.update-note code {
		color: var(--accent);
	}

	.update-note span {
		font-size: 0.52rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		white-space: nowrap;
	}

	.update-note code {
		font-family: inherit;
	}

	@media (hover: hover) {
		.install-tab:hover {
			color: var(--ink);
			background: var(--surface);
		}

		.install-tab[aria-selected="true"]:hover {
			color: var(--canvas);
			background: var(--accent-dark);
		}
	}

	@media (max-width: 29rem) {
		.runtime {
			display: none;
		}
	}
</style>
