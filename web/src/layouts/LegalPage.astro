---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Layout from "./Layout.astro";

type Section = {
  id: string;
  label: string;
};

type Props = {
  title: string;
  description: string;
  heading: string;
  summary: string;
  effectiveDate: string;
  active: "privacy" | "terms";
  sections: readonly Section[];
};

const { title, description, heading, summary, effectiveDate, active, sections } = Astro.props;
const documentCode = active === "privacy" ? "DOC_001" : "DOC_002";
---

<Layout title={title} description={description}>
	<SiteHeader active={active} />

	<main id="main-content" class="legal-page">
		<header class="legal-hero">
			<div class="document-meta">
				<p>{documentCode} · LIVEFEED POLICY</p>
				<p>Effective {effectiveDate}</p>
			</div>
			<h1>{heading}</h1>
			<p class="summary">{summary}</p>
		</header>

		<div class="legal-grid">
			<aside>
				<p>CONTENTS · {sections.length} SECTIONS</p>
				<nav aria-label={`${heading} sections`}>
					{
						sections.map((section, index) => (
							<a href={`#${section.id}`}>
								<span>{String(index + 1).padStart(2, "0")}</span>
								{section.label}
							</a>
						))
					}
				</nav>
			</aside>

			<article class="legal-content">
				<slot />
			</article>
		</div>
	</main>

	<SiteFooter />
</Layout>

<style>
	.legal-page {
		width: min(100%, var(--page-width));
		margin-inline: auto;
		padding-inline: var(--page-gutter);
	}

	.legal-hero {
		padding-block: clamp(3rem, 8vw, 7rem) clamp(4rem, 9vw, 7rem);
		border-bottom: 1px solid var(--line);
	}

	.document-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		color: var(--accent);
		font-size: 0.58rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.document-meta p {
		margin: 0;
	}

	h1 {
		max-width: 68rem;
		margin: clamp(2rem, 6vw, 5rem) 0 2rem;
		color: var(--accent);
		font-size: clamp(3.6rem, 9vw, 8rem);
		font-weight: 700;
		letter-spacing: -0.075em;
		line-height: 0.9;
		text-transform: uppercase;
	}

	.summary {
		max-width: 52rem;
		margin: 0;
		color: var(--ink);
		font-size: clamp(0.95rem, 1.6vw, 1.2rem);
		line-height: 1.65;
	}

	.legal-grid {
		display: grid;
		grid-template-columns: minmax(13rem, 0.32fr) minmax(0, 1fr);
		padding-bottom: clamp(6rem, 12vw, 10rem);
	}

	aside {
		align-self: start;
		padding: clamp(3rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem) 0 0;
		border-right: 1px solid var(--line);
	}

	aside > p {
		margin: 0 0 1.25rem;
		color: var(--accent);
		font-size: 0.58rem;
		font-weight: 600;
		letter-spacing: 0.08em;
	}

	aside nav {
		display: grid;
		border-top: 1px solid var(--line);
	}

	aside a {
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: 0.65rem;
		padding-block: 0.8rem;
		border-bottom: 1px solid var(--line);
		color: var(--ink-muted);
		font-size: 0.66rem;
		line-height: 1.35;
		text-decoration: none;
		transition: color 140ms var(--ease-out);
	}

	aside a span {
		color: var(--accent);
	}

	.legal-content {
		max-width: 52rem;
		padding: clamp(3rem, 6vw, 5rem) 0 0 clamp(2rem, 6vw, 6rem);
	}

	.legal-content :global(section) {
		padding-bottom: clamp(3.5rem, 7vw, 5.5rem);
		scroll-margin-top: 2rem;
	}

	.legal-content :global(section + section) {
		padding-top: clamp(3.5rem, 7vw, 5.5rem);
		border-top: 1px solid var(--line);
	}

	.legal-content :global(h2) {
		margin: 0 0 1.75rem;
		font-size: clamp(1.55rem, 3vw, 2.5rem);
		font-weight: 650;
		letter-spacing: -0.045em;
		line-height: 1;
		text-transform: uppercase;
	}

	.legal-content :global(h3) {
		margin: 2.25rem 0 0.8rem;
		font-size: 0.8rem;
		font-weight: 650;
		text-transform: uppercase;
	}

	.legal-content :global(p),
	.legal-content :global(li) {
		color: var(--ink-muted);
		font-size: 0.82rem;
		line-height: 1.8;
		text-wrap: pretty;
	}

	.legal-content :global(p) {
		margin: 0 0 1.15rem;
	}

	.legal-content :global(ul) {
		display: grid;
		gap: 0.65rem;
		margin: 1.25rem 0;
		padding-left: 1.25rem;
	}

	.legal-content :global(strong) {
		color: var(--ink);
		font-weight: 650;
	}

	.legal-content :global(code) {
		padding: 0.15em 0.35em;
		color: var(--accent);
		background: var(--surface);
		font-size: 0.9em;
	}

	.legal-content :global(a) {
		color: var(--accent);
		text-decoration-color: var(--line-strong);
		text-underline-offset: 0.2em;
	}

	@media (hover: hover) {
		aside a:hover {
			color: var(--accent);
		}
	}

	@media (max-width: 52rem) {
		.document-meta {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.5rem;
		}

		.legal-grid {
			grid-template-columns: 1fr;
		}

		aside {
			padding-right: 0;
			border-right: 0;
		}

		aside nav {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		aside a:nth-child(odd) {
			padding-right: 1rem;
			border-right: 1px solid var(--line);
		}

		aside a:nth-child(even) {
			padding-left: 1rem;
		}

		.legal-content {
			padding-left: 0;
		}
	}

	@media (max-width: 34rem) {
		aside nav {
			grid-template-columns: 1fr;
		}

		aside a:nth-child(odd),
		aside a:nth-child(even) {
			padding-inline: 0;
			border-right: 0;
		}
	}
</style>
