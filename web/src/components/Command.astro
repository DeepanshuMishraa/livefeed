---
type Props = {
	command: string;
	label?: string;
	large?: boolean;
};

const { command, label = "Copy command", large = false } = Astro.props;
---

<div class:list={["command", { large }]}>
	<span class="prompt" aria-hidden="true">$</span>
	<code>{command}</code>
	<button type="button" aria-label={label} title={label} data-copy-command={command}>
		<svg aria-hidden="true" viewBox="0 0 24 24">
			<rect x="8" y="8" width="11" height="11" rx="1"></rect>
			<path d="M16 8V5H5v11h3"></path>
		</svg>
		<span>Copy</span>
	</button>
</div>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-command]")) {
		button.addEventListener("click", async () => {
			const command = button.dataset.copyCommand;
			const label = button.querySelector("span");
			if (!command || !label) return;
			try {
				await navigator.clipboard.writeText(command);
				label.textContent = "Copied";
				button.dataset.copied = "true";
				window.setTimeout(() => {
					label.textContent = "Copy";
					delete button.dataset.copied;
				}, 1800);
			} catch {
				label.textContent = "Select";
			}
		});
	}
</script>

<style>
	.command {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.75rem;
		min-height: 3.5rem;
		padding: 0.5rem 0.5rem 0.5rem 1rem;
		border: 1px solid var(--line);
		background: var(--paper);
		transition:
			border-color 220ms var(--ease-out),
			transform 220ms var(--ease-out);
	}

	.command.large {
		min-height: 5rem;
		padding-left: clamp(1rem, 3vw, 1.75rem);
		border-color: var(--ink);
	}

	.prompt,
	code,
	button {
		font-family: var(--font-mono);
	}

	.prompt {
		color: var(--accent);
		font-weight: 500;
	}

	code {
		overflow-x: auto;
		color: var(--ink);
		font-size: 0.8rem;
		font-variant-ligatures: none;
		white-space: nowrap;
		scrollbar-width: none;
	}

	.large code {
		font-size: clamp(0.86rem, 2.2vw, 1.05rem);
	}

	button {
		display: inline-flex;
		min-width: 3rem;
		min-height: 2.5rem;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		padding: 0.5rem 0.75rem;
		border: 0;
		color: var(--ink-soft);
		background: var(--canvas-deep);
		cursor: pointer;
		font-size: 0.7rem;
		transition:
			color 140ms var(--ease-out),
			background-color 140ms var(--ease-out),
			transform 140ms var(--ease-out);
	}

	button svg {
		width: 0.9rem;
		height: 0.9rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
	}

	button[data-copied] {
		color: var(--paper);
		background: var(--accent-deep);
	}

	button:active {
		transform: scale(0.97);
	}

	@media (hover: hover) {
		.command:hover {
			border-color: var(--ink-soft);
			transform: translateY(-2px);
		}

		button:hover {
			color: var(--paper);
			background: var(--ink);
		}
	}

	@media (max-width: 29rem) {
		.command {
			gap: 0.5rem;
			padding-left: 0.75rem;
		}

		.command.large {
			min-height: 4.25rem;
		}

		button span {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
			white-space: nowrap;
		}
	}
</style>
