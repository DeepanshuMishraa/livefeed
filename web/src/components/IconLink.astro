---
type Icon = "github" | "npm";

type Props = {
  href: string;
  label: string;
  icon: Icon;
  iconOnly?: boolean;
};

const { href, label, icon, iconOnly = false } = Astro.props;
---

<a href={href} aria-label={label} class:list={{ "icon-only": iconOnly }}>
	{
		icon === "github" && (
			<svg aria-hidden="true" viewBox="0 0 24 24">
				<path
					d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.57 9.57 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
				></path>
			</svg>
		)
	}
	{
		icon === "npm" && (
			<svg aria-hidden="true" viewBox="0 0 24 24">
				<path d="M2 5h20v14H12v-3H9v3H2V5Zm3 3v8h3V8h3v8h3V8h3v8h2V8H5Z"></path>
			</svg>
		)
	}
	<span class:list={{ "visually-hidden": iconOnly }}>{label}</span>
</a>

<style>
	a {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		gap: 0.5rem;
		color: var(--ink-muted);
		font-size: 0.76rem;
		text-decoration: none;
		transition: color 140ms var(--ease-out);
	}

	.icon-only {
		width: 2.25rem;
		min-height: 2.25rem;
		justify-content: center;
		border: 1px solid var(--line);
	}

	svg {
		width: 1rem;
		height: 1rem;
		flex: none;
		fill: currentColor;
		transition: transform 180ms var(--ease-out);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (hover: hover) {
		a:hover {
			color: var(--ink);
		}

		a:hover svg {
			transform: translateY(-1px) scale(1.04);
		}
	}
</style>
